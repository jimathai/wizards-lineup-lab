# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local.
VITE_BDL_API_KEY=your_api_key_here

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supported values: local, supabase
VITE_PLAYER_DATA_PROVIDER=supabase

# Centralized NBA player-image path. Change this once to switch image size/source.
VITE_NBA_HEADSHOT_BASE_URL=https://cdn.nba.com/headshots/nba/latest/1040x760
