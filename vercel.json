{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/lineups/:ownerId/:teamId",
      "destination": "/api/share-page?ownerId=:ownerId&teamId=:teamId"
    },
    {
      "source": "/lineup/:lineupId",
      "destination": "/api/share-page?lineupId=:lineupId"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}